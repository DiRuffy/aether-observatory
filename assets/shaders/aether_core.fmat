material {
  name: "AetherCore",
  shading_model: lit,
  blending: opaque,
  culling: back,
  parameters: [
    { type: vec3, name: primary_color, default: [0.18, 0.85, 1.0] },
    { type: vec3, name: secondary_color, default: [1.0, 0.62, 0.18] },
    { type: float, name: energy_intensity, default: 2.8 },
    { type: float, name: surge_energy, default: 0.0 },
    { type: float, name: flow_speed, default: 1.0 },
    { type: float, name: iridescence_amount, default: 0.75 },
  ],
}

fragment {
  // Smooth cosine spectral palette for prismatic Fresnel iridescence.
  vec3 AetherSpectrum(float t) {
    return 0.5 + 0.5 * cos(6.28318 * (t + vec3(0.0, 0.33, 0.67)));
  }

  // Fast 3D domain-warped trigonometric plasma field (WebGL2 friendly).
  float PlasmaField(vec3 p, float t) {
    vec3 q = p * 2.6;
    q += 0.55 * sin(q.yzx * 1.7 + vec3(t * 1.1, -t * 0.9, t * 0.7));
    q += 0.35 * cos(q.zxy * 2.9 - vec3(t * 1.6, t * 1.3, -t * 1.2));
    float wave = sin(q.x * 2.1 + q.y * 1.8 - q.z * 2.4 + t * 1.4);
    float veins = 1.0 - abs(wave);
    return pow(clamp(veins, 0.0, 1.0), 3.0);
  }

  void Surface(inout MaterialInputs material) {
    vec3 N = GetWorldNormal();
    vec3 V = GetViewDirection();
    vec3 P = GetWorldPosition();

    float t = GetTime() * (0.85 + 0.9 * material_params.flow_speed);
    float ndotv = clamp(dot(N, V), 0.0, 1.0);
    float fresnel = pow(1.0 - ndotv, 2.4);

    // Dual-layer counter-flowing plasma filaments.
    float p1 = PlasmaField(P * 1.35 + vec3(0.0, -t * 0.35, 0.0), t);
    float p2 = PlasmaField(P * 2.2 - vec3(t * 0.25, 0.0, t * 0.2), t * 1.35);
    float plasma = clamp(p1 * 0.72 + p2 * 0.58, 0.0, 1.0);

    // Subtle harmonic heartbeat + surge flare.
    float pulse = 0.88 + 0.12 * sin(t * 2.6 + P.y * 3.0);
    float surge = clamp(material_params.surge_energy, 0.0, 2.0);

    // Iridescent thin-film shimmer across viewing angle.
    vec3 spectral = AetherSpectrum(ndotv * 1.35 + t * 0.12 + p1 * 0.25);
    vec3 core_mix = mix(
      material_params.secondary_color,
      material_params.primary_color,
      clamp(plasma * 0.8 + fresnel * 0.45, 0.0, 1.0)
    );
    vec3 iridescent_mix = mix(
      core_mix,
      spectral * 1.15,
      material_params.iridescence_amount * fresnel * 0.65
    );

    // Dark crystalline base with metallic specular reflections.
    material.base_color = vec4(core_mix * 0.12, 1.0);
    material.metallic = 0.88;
    material.roughness = 0.12;

    // HDR emissive drives cinematic bloom and lens flares.
    float glow_scale = material_params.energy_intensity * pulse * (1.0 + surge * 2.4);
    float hotspot = pow(plasma, 2.2) * 1.65 + fresnel * (1.35 + surge * 1.4);
    vec3 white_core = vec3(1.0, 0.98, 0.95) * (pow(plasma, 4.0) * 1.5 + surge * 1.8);
    material.emissive = iridescent_mix * glow_scale * (0.28 + hotspot) + white_core;

    PrepareMaterial(material);
  }
}
